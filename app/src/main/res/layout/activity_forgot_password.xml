<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".ForgotPasswordActivity">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="160dp"
            android:layout_height="106dp"
            android:contentDescription="@string/app_logo"
            android:src="@drawable/logo_macro_tracker" />

        <TextView
            android:layout_width="270dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/nunito_bold"
            android:gravity="center"
            android:text="@string/forgot_password_title"
            android:textColor="@color/primary"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/descriptionText"
            android:layout_width="270dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/nunito_medium"
            android:gravity="center"
            android:text="@string/forgot_password_description"
            android:textColor="@color/secondary_gray_text"
            android:textSize="13sp" />

        <TextView
            android:layout_width="270dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="8dp"
            android:fontFamily="@font/nunito_bold"
            android:gravity="start"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="@string/email"
            android:textColor="@color/primary"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/emailInput"
            android:layout_width="270dp"
            android:layout_height="48dp"
            android:autofillHints="emailAddress"
            android:background="@drawable/bg_bordered_container"
            android:fontFamily="@font/nunito_medium"
            android:gravity="center_vertical"
            android:hint="@string/email"
            android:inputType="textEmailAddress"
            android:padding="10dp"
            android:textColor="@color/primary_gray_text"
            android:textColorHint="@color/secondary_gray_text"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/emailError"
            android:layout_width="270dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/nunito_medium"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="@string/email_error"
            android:textColor="@color/error"
            android:textSize="11sp"
            android:visibility="invisible" />

        <Button
            android:id="@+id/sendBtn"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
            android:layout_width="270dp"
            android:layout_height="48dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_primary_container_cr10"
            android:fontFamily="@font/nunito_bold"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:letterSpacing="0"
            android:text="@string/send_reset_link"
            android:textAllCaps="false"
            android:textColor="@color/white"
            app:backgroundTint="@null" />

        <TextView
            android:id="@+id/sentMessage"
            android:layout_width="270dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/nunito_medium"
            android:gravity="center"
            android:text="@string/reset_link_sent"
            android:textColor="@color/primary"
            android:textSize="13sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/backToLoginLink"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/nunito_bold"
            android:padding="8dp"
            android:text="@string/back_to_login"
            android:textColor="@color/primary"
            android:textSize="13sp" />

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
